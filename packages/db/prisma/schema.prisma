generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            String            @id @default(cuid())
  name                          String
  email                         String?
  authUserId                    String?
  locale                        String            @default("en") @db.VarChar(5)
  householdId                   String?
  onboardingHouseholdDecisionAt DateTime?
  sessionRevokedAt              DateTime?
  household                     Household?        @relation(fields: [householdId], references: [id], onDelete: SetNull)
  createdAt                     DateTime          @default(now())
  incomes                       MonthlyIncome[]
  paidExpenses                  Expense[]         @relation("ExpensePaidByUser")
  fixedTemplates                ExpenseTemplate[] @relation("TemplatePaidByUser")
  createdInvites                HouseholdInvite[] @relation("InviteCreatedBy")
  consumedInvites               HouseholdInvite[] @relation("InviteConsumedBy")
  passkeys                      UserPasskey[]
  revokedSessions               RevokedSession[]

  @@unique([authUserId])
  @@index([householdId])
}

/// A single session signed out before its token would have expired.
///
/// Sessions are stateless, so only the exceptions are stored: logging out adds
/// one row and leaves the user's other devices alone. `User.sessionRevokedAt`
/// still exists for the account-wide case ("sign out everywhere"), which is a
/// deliberate action rather than what an ordinary logout does.
model RevokedSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The `sid` claim of the revoked token.
  sessionId String
  createdAt DateTime @default(now())
  /// Mirrors the token's `exp`: once past, the token is dead on its own and the
  /// row can be pruned.
  expiresAt DateTime

  @@unique([sessionId])
  @@index([userId, expiresAt])
}

/// A WebAuthn credential registered by a user as a secondary sign-in method.
model UserPasskey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Base64url-encoded credential ID as reported by the authenticator.
  credentialId String
  publicKey    Bytes
  /// Authenticator signature counter. Many passkeys always report 0.
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  /// 'singleDevice' or 'multiDevice' as reported during registration.
  deviceType   String    @db.VarChar(16)
  backedUp     Boolean   @default(false)
  /// User-supplied name so multiple passkeys stay distinguishable.
  label        String    @db.VarChar(60)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@unique([credentialId])
  @@index([userId])
}

/// Single-use WebAuthn challenge. Persisted rather than held in memory so the
/// stateless API can be scaled horizontally, and deleted on consumption so a
/// captured registration or assertion cannot be replayed.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  /// 'registration' or 'authentication'.
  purpose   String   @db.VarChar(16)
  /// Set for registration (which requires a session); null for usernameless login.
  userId    String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model MonthlyIncome {
  id             String    @id @default(cuid())
  month          String    @db.VarChar(7)
  description    String    @default("Income")
  amount         Decimal   @db.Decimal(14, 2)
  amountOriginal Decimal   @db.Decimal(14, 2)
  currencyCode   String    @default("ARS") @db.VarChar(3)
  fxRateUsed     Decimal   @default(1) @db.Decimal(14, 6)
  householdId    String
  household      Household @relation(fields: [householdId], references: [id], onDelete: SetNull)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([month])
  @@index([month, userId, id])
  @@index([userId])
  @@index([householdId])
  @@index([householdId, month])
}

model Category {
  id               String            @id @default(cuid())
  name             String
  icon             String            @default("receipt")
  householdId      String
  household        Household         @relation(fields: [householdId], references: [id], onDelete: SetNull)
  superCategoryId  String?
  superCategory    SuperCategory?    @relation(fields: [superCategoryId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  archivedAt       DateTime?
  expenses         Expense[]
  expenseTemplates ExpenseTemplate[]

  @@unique([householdId, name])
  @@index([archivedAt, name])
  @@index([superCategoryId])
  @@index([householdId])
}

model SuperCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  color       String     @default("#64748b")
  icon        String     @default("dots")
  sortOrder   Int        @default(0)
  isSystem    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  archivedAt  DateTime?
  categories  Category[]

  @@unique([householdId, slug])
  @@index([archivedAt, sortOrder, name])
  @@index([householdId])
}

model Expense {
  id                  String           @id @default(cuid())
  month               String           @db.VarChar(7)
  date                DateTime
  description         String
  categoryId          String
  category            Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amountOriginal      Decimal          @db.Decimal(14, 2)
  amountArs           Decimal          @db.Decimal(14, 2)
  currencyCode        String           @default("ARS") @db.VarChar(3)
  fxRateUsed          Decimal          @default(1) @db.Decimal(14, 6)
  isInstallment       Boolean          @default(false)
  installmentSeriesId String?
  installmentNumber   Int?
  installmentTotal    Int?
  installmentAmount   Decimal?         @db.Decimal(14, 2)
  installmentSource   String?
  originalTotalAmount Decimal?         @db.Decimal(14, 2)
  createdFromSeries   Boolean          @default(false)
  householdId         String
  household           Household        @relation(fields: [householdId], references: [id], onDelete: SetNull)
  templateId          String?
  template            ExpenseTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  paidByUserId        String
  paidByUser          User             @relation("ExpensePaidByUser", fields: [paidByUserId], references: [id], onDelete: Restrict)

  @@unique([month, templateId])
  @@unique([installmentSeriesId, month])
  @@index([month])
  @@index([month, isInstallment])
  @@index([paidByUserId])
  @@index([categoryId])
  @@index([templateId])
  @@index([templateId, month])
  @@index([month, templateId])
  @@index([month, date(sort: Desc), id(sort: Desc)])
  @@index([installmentSeriesId, installmentNumber])
  @@index([householdId])
  @@index([householdId, month])
}

model ExpenseTemplate {
  id             String                      @id @default(cuid())
  description    String
  categoryId     String
  category       Category                    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amountOriginal Decimal                     @db.Decimal(14, 2)
  amountArs      Decimal                     @db.Decimal(14, 2)
  currencyCode   String                      @default("ARS") @db.VarChar(3)
  fxRate         Decimal                     @db.Decimal(14, 6)
  dayOfMonth     Int
  isActive       Boolean                     @default(true)
  householdId    String
  household      Household                   @relation(fields: [householdId], references: [id], onDelete: SetNull)
  paidByUserId   String
  paidByUser     User                        @relation("TemplatePaidByUser", fields: [paidByUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  expenses       Expense[]
  skippedMonths  RecurringExpenseSkipMonth[]

  @@index([isActive])
  @@index([isActive, createdAt])
  @@index([categoryId])
  @@index([paidByUserId])
  @@index([householdId])
}

model RecurringExpenseSkipMonth {
  id         String          @id @default(cuid())
  templateId String
  template   ExpenseTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  month      String          @db.VarChar(7)
  createdAt  DateTime        @default(now())

  @@unique([templateId, month])
  @@index([month])
}

model MonthlyExchangeRate {
  id           String    @id @default(cuid())
  month        String    @db.VarChar(7)
  currencyCode String    @db.VarChar(3)
  rateToArs    Decimal   @db.Decimal(14, 6)
  householdId  String
  household    Household @relation(fields: [householdId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([householdId, month, currencyCode])
  @@index([month])
  @@index([householdId])
}

model Household {
  id               String                @id @default(cuid())
  name             String
  createdAt        DateTime              @default(now())
  users            User[]
  incomes          MonthlyIncome[]
  expenses         Expense[]
  expenseTemplates ExpenseTemplate[]
  categories       Category[]
  superCategories  SuperCategory[]
  exchangeRates    MonthlyExchangeRate[]
  invites          HouseholdInvite[]
}

model HouseholdInvite {
  id               String    @id @default(cuid())
  householdId      String
  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  code             String    @unique
  createdByUserId  String
  createdByUser    User      @relation("InviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  consumedByUserId String?
  consumedByUser   User?     @relation("InviteConsumedBy", fields: [consumedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  consumedAt       DateTime?
  isRevoked        Boolean   @default(false)

  @@index([householdId, expiresAt])
  @@index([createdByUserId])
}

{
  "name": "fairsplit",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "prebuild": "pnpm --filter @fairsplit/db prisma:generate",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e:agentmail:onboarding": "pnpm --filter @fairsplit/api exec node --env-file-if-exists=.env --env-file-if-exists=../web/.env.local --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env --import tsx ../../scripts/e2e-agentmail-onboarding.ts",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @fairsplit/db prisma:generate",
    "db:new-migration": "./scripts/migrations.sh new",
    "db:verify": "./scripts/migrations.sh verify",
    "db:reset-test": "./scripts/migrations.sh reset-test"
  },
  "devDependencies": {
    "prettier": "^3.5.1",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "defu": "6.1.7",
      "next>postcss": "8.5.23",
      "next>sharp": "0.35.3"
    }
  }
}

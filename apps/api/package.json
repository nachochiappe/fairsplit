{
  "name": "@fairsplit/api",
  "version": "0.0.1",
  "private": true,
  "main": "dist/apps/api/src/server.js",
  "types": "dist/apps/api/src/server.d.ts",
  "scripts": {
    "prebuild": "pnpm --filter @fairsplit/logging build",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "pnpm --filter @fairsplit/logging build",
    "start": "node --env-file-if-exists=.env dist/apps/api/src/server.js",
    "test": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run",
    "lint": "echo 'No lint step for @fairsplit/api'"
  },
  "dependencies": {
    "@fairsplit/db": "workspace:*",
    "@fairsplit/logging": "workspace:*",
    "@fairsplit/shared": "workspace:*",
    "@simplewebauthn/server": "^13.3.2",
    "decimal.js": "^10.5.0",
    "express": "^5.1.0",
    "pino-http": "^11.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
